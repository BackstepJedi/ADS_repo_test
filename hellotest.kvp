Meta.DisplayName=HelloTest
Meta.Description=Minimal test template to verify ADS scans GenericTemplates
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=You
Meta.EndpointURIFormat={ip}:0
Meta.ConfigManifest=hellotestconfig.json
Meta.MetaConfigManifest=hellotestmetaconfig.json
Meta.ConfigRoot=hellotest.kvp
Meta.MinAMPVersion=2.5.0.0
Meta.ConfigVersion=3
Meta.AppConfigId=e0ae7e2b-c1a7-4874-a0df-26680d2214fa

App.DisplayName=HelloTest
App.RootDir=./hellotest/
App.BaseDirectory=./hellotest/base/
App.ExecutableWin=cmd.exe
App.ExecutableLinux=/bin/sh
App.WorkingDir=.
App.WindowsCommandLineArgs=/c ping 127.0.0.1 -t
App.LinuxCommandLineArgs=-c "sleep 3600"
App.CommandLineArgs=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=CtrlC
App.ExitTimeout=10
App.Ports=[]

Console.AppReadyRegex=^.*$
